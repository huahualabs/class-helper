{
  "name": "class-helper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:unit": "node --test test/*.test.js",
    "dev": "vite",
    "dev:central-emulator": "VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=owner-parent-portal VITE_CENTRAL_PORTAL_CLASS_ID=class-115-309 VITE_SHARED_CALENDAR_SOURCE_MODE=central VITE_CENTRAL_USE_FIREBASE_EMULATORS=true VITE_CENTRAL_FIREBASE_EMULATOR_PROJECT_ID=demo-class-helper-class-events VITE_CENTRAL_AUTH_EMULATOR_PORT=9499 VITE_CENTRAL_FIRESTORE_EMULATOR_PORT=8580 vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:schedule-emulator": "VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=owner-parent-portal VITE_CENTRAL_PORTAL_CLASS_ID=class-115-309 VITE_SHARED_SCHEDULE_SOURCE_MODE=central VITE_CENTRAL_USE_FIREBASE_EMULATORS=true VITE_CENTRAL_FIREBASE_EMULATOR_PROJECT_ID=demo-class-schedules VITE_CENTRAL_AUTH_EMULATOR_PORT=9599 VITE_CENTRAL_FIRESTORE_EMULATOR_PORT=8780 vite --host 127.0.0.1 --port 5175 --strictPort",
    "dev:schedule-import-emulator": "VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=owner-parent-portal VITE_CENTRAL_PORTAL_CLASS_ID=class-115-309 VITE_SHARED_SCHEDULE_SOURCE_MODE=legacy VITE_CENTRAL_USE_FIREBASE_EMULATORS=true VITE_CENTRAL_FIREBASE_EMULATOR_PROJECT_ID=demo-class-schedules VITE_CENTRAL_AUTH_EMULATOR_PORT=9599 VITE_CENTRAL_FIRESTORE_EMULATOR_PORT=8780 vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vite build",
    "build:generic": "VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=generic vite build",
    "build:owner": "vite build --mode owner-production",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "vue": "^3.5.39",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^8.1.1"
  }
}
