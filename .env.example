# Generic distribution is the safe default. It uses localStorage and optionally
# each teacher's own Firebase RTDB configured at runtime in Data Center.
VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=generic

# Adjust for the hosting location. Use / for a root deployment.
VITE_CLASS_HELPER_BASE_PATH=/class-helper/

# Generic builds intentionally have no parent-portal project, class ID, central
# Firebase credentials, or production migration flags.
