VITE_CENTRAL_PORTAL_CLASS_ID=class-115-309

# Explicit source switch. For this phase, local testing uses `central` together with
# VITE_CENTRAL_USE_FIREBASE_EMULATORS=true. Non-Emulator central access is blocked.
# Rollback is `legacy`; the two sources are never merged or double-written.
VITE_SHARED_CALENDAR_SOURCE_MODE=legacy

# Central class-parent-portal Firebase web application (not the personal RTDB project).
VITE_CENTRAL_FIREBASE_API_KEY=
VITE_CENTRAL_FIREBASE_AUTH_DOMAIN=
VITE_CENTRAL_FIREBASE_PROJECT_ID=class-parent-portal
VITE_CENTRAL_FIREBASE_STORAGE_BUCKET=
VITE_CENTRAL_FIREBASE_MESSAGING_SENDER_ID=
VITE_CENTRAL_FIREBASE_APP_ID=

# Local development only. Dedicated defaults are Auth 9499 / Firestore 8580.
VITE_CENTRAL_USE_FIREBASE_EMULATORS=false
VITE_CENTRAL_FIREBASE_EMULATOR_PROJECT_ID=demo-class-helper-class-events
VITE_CENTRAL_AUTH_EMULATOR_PORT=9499
VITE_CENTRAL_FIRESTORE_EMULATOR_PORT=8580
VITE_CENTRAL_EMULATOR_TEACHER_EMAIL=calendar.teacher@demo.invalid
VITE_CENTRAL_EMULATOR_TEACHER_PASSWORD=calendar-emulator-only
