# Optional owner-only build profile. Never use this file for the generic public build.
VITE_CLASS_HELPER_DEPLOYMENT_PROFILE=owner-parent-portal
VITE_CLASS_HELPER_BASE_PATH=/

VITE_CENTRAL_PORTAL_CLASS_ID=your-shared-class-id
VITE_SHARED_CALENDAR_SOURCE_MODE=central
# Keep legacy until the one-time import and read-back verification succeed.
# Change to central only after that separate manual approval.
VITE_SHARED_SCHEDULE_SOURCE_MODE=legacy

VITE_CENTRAL_FIREBASE_API_KEY=
VITE_CENTRAL_FIREBASE_AUTH_DOMAIN=
VITE_CENTRAL_FIREBASE_PROJECT_ID=your-parent-portal-project-id
VITE_CENTRAL_FIREBASE_APP_ID=

# Optional owner deployment convenience. Keep empty in generic source.
VITE_PERSONAL_FIREBASE_BUILTIN_APPCHECK_PROJECT_ID=
VITE_PERSONAL_FIREBASE_BUILTIN_APPCHECK_SITE_KEY=

# Both production capabilities are fail-closed by default.
VITE_CENTRAL_USE_FIREBASE_EMULATORS=false
VITE_ENABLE_OWNER_CENTRAL_PRODUCTION=false
VITE_ENABLE_PRODUCTION_SCHEDULE_IMPORT=false
